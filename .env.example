# Copy this file to .env and fill in the values. Never commit .env.
#
# Pooled connection string for the app (Neon host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Direct/unpooled connection string for Alembic migrations.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
#
# Optional separate Neon database or branch for DB tests. Must differ from DATABASE_URL.
# TEST_DATABASE_URL=
#
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
MAX_UPLOAD_ROWS=200000
#
# Seeded administrator account. The app creates or updates this account at
# start-up and makes it admin. Sign in on the Account page with the username or
# email plus this password. The Admin page then opens without a second prompt.
# A Streamlit secret named "admin_password" takes precedence over ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@churnlab.local
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=
#
# Secret salt for anonymous visitor hashing. Use a long random string.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank to disable visitor recording. The banner then shows stored counts.
VISITOR_HASH_SALT=
#
# Set to false to close public account creation after the demo accounts exist.
ALLOW_SIGNUP=true
#
# Signed-in session lifetime in hours. Streamlit sessions also end on reload.
SESSION_MAX_HOURS=12
