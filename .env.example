# Copy this file to .env and fill in the values. Never commit .env.
#
# Pooled connection string for the app (Neon host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Direct/unpooled connection string for Alembic migrations.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
#
# Optional separate Neon database or branch for DB tests. Must differ from DATABASE_URL.
# TEST_DATABASE_URL=
#
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
MAX_UPLOAD_ROWS=200000
